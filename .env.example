# Copy to .env and fill in. Never commit the real file.
# The Qloo credential is issue-tracked per participant: do not share it.

# --- Required for live Qloo data -------------------------------------------
# From the Qloo Agentic Hackathon onboarding (Devpost / event Discord).
QLOO_API_KEY=

# --- Optional --------------------------------------------------------------
# Force labeled sample data even when a key is present. Useful for screenshots.
# DUET_MODE=fixture

# HTTP port (Render sets this automatically).
PORT=8080

# Path to the harness entry if it is not in node_modules (local development).
# QLOO_HARNESS_ENTRY=/path/to/@qloo/qloo-harness/dist/bin.js

# --- Optional verdict writer ----------------------------------------------
# Any OpenAI-compatible endpoint. Without these the deterministic writer is used.
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
