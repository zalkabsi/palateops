# Configure QLOO_API_KEY only in the Node backend host's secret manager.
# Configure QLOO_BACKEND_TOKEN in both the backend and Site runtime secret stores.
# Configure QLOO_BACKEND_URL in the Site runtime as the backend's HTTPS origin.
# Never place either secret in browser storage, source control, or a demo recording.
QLOO_API_KEY=
QLOO_BACKEND_TOKEN=
QLOO_BACKEND_URL=
# Optional AI planner: configure only in the Node backend host.
PALATEOPS_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
